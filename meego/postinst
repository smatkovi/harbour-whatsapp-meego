#!/bin/sh
# Nach dem Auspacken: Namen eintragen, die alte Instanz ablösen, WhatsApp in
# pybridge einhaengen und die Konten anlegen.
set -e

# --- 1) Der lokale Name fuer die SIP-Bruecke --------------------------------
# Die Kontoverwaltung prueft die SIP-Adresse wie eine Mailadresse und nimmt
# weder "whatsapp" allein noch eine nackte IP. Mit whatsapp.local geht sie
# durch, und /etc/hosts zeigt den Namen auf die Loopback-Schnittstelle, wo
# die Bruecke lauscht.
NAME=whatsapp.local
if ! grep -q "[[:space:]]$NAME\([[:space:]]\|$\)" /etc/hosts 2>/dev/null; then
    printf '127.0.0.1 %s\n' "$NAME" >> /etc/hosts
    echo "harbour-whatsapp: $NAME in /etc/hosts eingetragen"
fi

# --- 2) Die laufende alte Instanz ablösen -----------------------------------
# "initctl stop" genuegt dafuer nicht: der Anstossjob startet das Backend
# nicht selbst, er bittet nur den Sitzungs-D-Bus um die Aktivierung -- und
# haelt danach nichts in der Hand, was er beenden koennte. Beim Upgrade auf
# 1.3 lief deshalb weiter das alte Binary, und die Korrektur, um die es
# ging, war nicht wirksam. /quit beendet sauber: es sichert vorher.
for p in 8085 8086 8087 8088 8089; do
    curl -s -m 5 "http://127.0.0.1:$p/quit" >/dev/null 2>&1 || true
done

# --- 3) WhatsApp in pybridge einhaengen -------------------------------------
# Nur wenn pybridge ueberhaupt da ist. Ohne den Verbindungsmanager gibt es
# keine Nachrichten-App-Anbindung -- die App selbst laeuft trotzdem.
ANGEPASST=0
if [ -f /opt/pybridge/pybridge_cm.py ]; then
    if /usr/bin/python /opt/pywhatsapp/patch-pybridge.py; then
        ANGEPASST=1
    else
        echo "harbour-whatsapp: pybridge nicht angepasst - Nachrichten-App-Anbindung bleibt aus" >&2
    fi
fi

# Beide muessen neu starten, und in dieser Reihenfolge: der
# Verbindungsmanager liest seine Protokollliste nur beim Start, und Mission
# Control fragt fuer "kennst du dieses Protokoll?" den laufenden Manager.
# Laeuft noch der alte, antwortet mc-tool mit "Protocol whatsapp not found"
# -- genau daran scheiterte der erste Versuch. Beide werden bei Bedarf von
# selbst wieder aktiviert.
if [ "$ANGEPASST" = "1" ]; then
    pkill -f pybridge_cm.py       >/dev/null 2>&1 || true
    sleep 1
    pkill -f mission-control-5    >/dev/null 2>&1 || true
    sleep 4
fi

# --- 4) Konten: hier nicht ---------------------------------------------------
# Die beiden Konten (pybridge fuer die Nachrichten-App, SIP fuer Anrufe)
# legt die App beim Start an, nicht dieses Skript. Der Grund ist Aegis: von
# hier aus laeuft alles als root, mc-tool und ag-tool schreiben aber in die
# Kontoverzeichnisse der Sitzung, und jeder Weg zum Kennungswechsel ist
# versperrt -- "su: can't set groups: Operation not permitted" ebenso wie
# "start-stop-daemon: unable to set gid to 29999". Die App dagegen laeuft
# ohnehin als "user" und hat den Sitzungsbus.

# --- 5) Das Backend wieder hochziehen ----------------------------------------
# Nicht ueber initctl: aus dem dpkg-Kontext scheitert das ebenso still wie
# der Kennungswechsel, und dann steht das Backend bis zum naechsten
# Anmelden. Beim Upgrade auf 1.5 war es genau so -- die App meldete
# "connection refused".
#
# Der Weg, der geht, ist derselbe, den der Anstossjob nimmt: ein nackter
# root kommt an den Sitzungs-D-Bus heran, und ein darueber aktivierter
# Dienst laeuft als Besitzer des Busses, also als "user". --print-reply ist
# Pflicht, sonst kehrt der Aufruf zurueck, bevor D-Bus die Aktivierung
# bearbeitet hat.
BUS=$(sed -n 's/.*DBUS_SESSION_BUS_ADDRESS=//p' /tmp/session_bus_address.user 2>/dev/null \
      | tr -d '";' | head -1)
if [ -n "$BUS" ]; then
    DBUS_SESSION_BUS_ADDRESS="$BUS" dbus-send --session --print-reply \
        --dest=org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus.StartServiceByName \
        string:org.smatkovi.WhatsApp uint32:0 >/dev/null 2>&1 || true
fi
# --- Symbolvorrat auffrischen ------------------------------------------------
# mthemedaemon liest die Symbole des Themas beim Start ein. Was danach
# hinzukommt, kennt er nicht -- und statt des Dienstsymbols malt die
# Nachrichten-App dann ein rotes Ersatzquadrat. Ein Neustart des Dienstes
# genuegt; er wird von seinem Aufseher sofort wieder hochgezogen. Die
# Alternative waere, den Nutzer um einen Neustart des Geraets zu bitten.
pkill -x mthemedaemon >/dev/null 2>&1 || true

exit 0
