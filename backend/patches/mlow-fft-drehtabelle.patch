+// drehtabelle liefert die n Einheitswurzeln e^(sign*2*pi*i*m/n), m in [0,n).
+//
+// Vorher rechnete jeder einzelne Schmetterling seinen Drehfaktor mit
+// math.Cos und math.Sin aus. Im Profil des Kodierers gingen dafuer 50 %
+// der gesamten Rechenzeit drauf (math.cos 40 %, math.sin 10 %) -- auf
+// einem ARM ohne Hardware fuer Winkelfunktionen noch deutlich mehr. Die
+// Winkel sind aber immer sign*2*pi*(k*j mod n)/n: es gibt nur n
+// verschiedene, und sie aendern sich nie. Einmal je Laenge gerechnet,
+// danach nachgeschlagen.
+var drehtabellen sync.Map // int64 -> []cpx
+
+func drehtabelle(n int, sign float32) []cpx {
+	schluessel := int64(n)
+	if sign > 0 {
+		schluessel = -schluessel
+	}
+	if t, ok := drehtabellen.Load(schluessel); ok {
+		return t.([]cpx)
+	}
+	t := make([]cpx, n)
+	for m := 0; m < n; m++ {
+		w := float64(sign) * 2.0 * math.Pi * float64(m) / float64(n)
+		t[m] = cpx{re: float32(math.Cos(w)), im: float32(math.Sin(w))}
+	}
+	drehtabellen.Store(schluessel, t)
+	return t
+}
+
 // fftRec is the recursive mixed-radix Cooley-Tukey DFT. sign is -1 forward, +1
 // inverse (unnormalized). x holds n inputs at the given stride; out is contiguous.
+// Kratzspeicher fuer die Rekursion, nach Laenge sortiert.
+//
+// Vorher legte jeder Knoten der Rekursion sein eigenes Feld an: bei einer
+// Laenge von 512 sind das mehrere hundert Felder je FFT, und im Kodierer
+// laufen mehrere FFTs je Rahmen. Auf einem Geraet mit langsamem Speicher
+// und einem Sammler, der sich das alles ansehen muss, kostet das mehr als
+// das Rechnen selbst. Gebraucht werden hoechstens 2n Werte: n fuer diese
+// Ebene, und weil die Kinder nacheinander drankommen, reicht ihnen der
+// Rest zusammen.
+var kratzfelder sync.Pool
+
+func kratz(n int) []cpx {
+	if v := kratzfelder.Get(); v != nil {
+		f := v.([]cpx)
+		if len(f) >= n {
+			return f
+		}
+	}
+	return make([]cpx, n)
+}
+
+func kratzZurueck(f []cpx) { kratzfelder.Put(f) }
+
 func fftRec(x []cpx, stride, n int, sign float32, out []cpx) {
+	k := kratz(2 * n)
+	fftRecKratz(x, stride, n, sign, out, k)
+	kratzZurueck(k)
+}
