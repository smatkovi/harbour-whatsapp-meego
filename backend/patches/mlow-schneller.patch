diff -ruN meowcaller-rein/mlow/dtx_test.go meowcaller-fix/mlow/dtx_test.go
--- a/mlow/dtx_test.go	1970-01-01 01:00:00.000000000 +0100
+++ b/mlow/dtx_test.go	2026-09-24 22:37:23.593156250 +0200
@@ -0,0 +1,72 @@
+package mlow
+
+import (
+	"math"
+	"testing"
+)
+
+// In Sprechpausen soll nur das TOC-Byte hinausgehen -- aber nur, wenn der
+// Schalter steht, und Sprache muss unberuehrt bleiben.
+func TestDtxSchicktNurDasTocByte(t *testing.T) {
+	stille := make([]float32, 960)
+	sprache := make([]float32, 960)
+	for i := range sprache {
+		h := 0.5 * (1 - float32(math.Cos(2*math.Pi*float64(i)/960)))
+		sprache[i] = h * 0.4 * float32(math.Sin(float64(i)*0.05))
+	}
+
+	// Ohne Schalter bleibt alles wie bisher.
+	dtxEinmal.Do(func() {})
+	dtxWert = false
+	ohne := NewMlowEncoder()
+	for i := 0; i < 3; i++ {
+		ohne.Encode(stille)
+	}
+	voll, err := ohne.Encode(stille)
+	if err != nil {
+		t.Fatalf("Kodieren: %v", err)
+	}
+	if len(voll) <= 1 {
+		t.Fatalf("ohne Schalter kam ein Rahmen aus %d Byte", len(voll))
+	}
+
+	// Mit Schalter: ein Byte, und es sagt "nicht aktiv".
+	dtxWert = true
+	defer func() { dtxWert = false }()
+	mit := NewMlowEncoder()
+	for i := 0; i < 5; i++ {
+		mit.Encode(stille)
+	}
+	kurz, err := mit.Encode(stille)
+	if err != nil {
+		t.Fatalf("Kodieren mit DTX: %v", err)
+	}
+	if len(kurz) != 1 {
+		t.Fatalf("mit DTX kam ein Rahmen aus %d Byte, erwartet 1", len(kurz))
+	}
+	toc := ParseSmplTOC(kurz[0])
+	if toc.Active {
+		t.Fatalf("das TOC-Byte %#x sagt aktiv", kurz[0])
+	}
+	if toc.FrameMs != 60 || toc.SampleRate != 16000 {
+		t.Fatalf("TOC %#x: %d ms, %d Hz", kurz[0], toc.FrameMs, toc.SampleRate)
+	}
+
+	// Der Dekodierer muss damit umgehen, ohne zu stolpern.
+	dec := NewMlowDecoder()
+	pcm := dec.Decode(kurz)
+	for i, v := range pcm {
+		if v != 0 {
+			t.Fatalf("Stelle %d ist %v, erwartet Stille", i, v)
+		}
+	}
+
+	// Sprache geht weiterhin vollstaendig hinaus.
+	lang, err := mit.Encode(sprache)
+	if err != nil {
+		t.Fatalf("Sprache kodieren: %v", err)
+	}
+	if len(lang) <= 1 {
+		t.Fatalf("Sprache kam als %d Byte heraus", len(lang))
+	}
+}
