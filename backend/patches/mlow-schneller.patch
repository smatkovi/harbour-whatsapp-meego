diff -ruN meowcaller-rein/mlow/fft_dft_test.go meowcaller-fix/mlow/fft_dft_test.go
--- a/mlow/fft_dft_test.go	1970-01-01 01:00:00.000000000 +0100
+++ b/mlow/fft_dft_test.go	2026-09-24 22:37:23.593307287 +0200
@@ -0,0 +1,59 @@
+package mlow
+
+import (
+	"math"
+	"math/rand"
+	"testing"
+)
+
+// Unabhaengiger Massstab: die schlichte Doppelsumme. Sie ist zu langsam fuer
+// den Betrieb, aber genau deshalb taugt sie als Vergleich -- die schnellen
+// Wege (ausgeschriebene Basis 2 und 3, Drehtabelle, Kratzspeicher) muessen
+// dasselbe liefern.
+func naiveDft(x []cpx, sign float32) []cpx {
+	n := len(x)
+	out := make([]cpx, n)
+	for k := 0; k < n; k++ {
+		var re, im float64
+		for j := 0; j < n; j++ {
+			w := float64(sign) * 2 * math.Pi * float64(k) * float64(j) / float64(n)
+			c, s := math.Cos(w), math.Sin(w)
+			re += float64(x[j].re)*c - float64(x[j].im)*s
+			im += float64(x[j].re)*s + float64(x[j].im)*c
+		}
+		out[k] = cpx{re: float32(re), im: float32(im)}
+	}
+	return out
+}
+
+func TestCfftGegenDoppelsumme(t *testing.T) {
+	r := rand.New(rand.NewSource(11))
+	// 256 und 288 sind die Laengen, die der Kodierer nach der Halbierung
+	// wirklich rechnet; 512 und 576 waren es vorher. 6 und 12 nehmen die
+	// Basis 3 mit, 7 den allgemeinen Weg fuer Primzahlen.
+	for _, n := range []int{2, 3, 4, 6, 7, 8, 12, 256, 288} {
+		x := make([]cpx, n)
+		for i := range x {
+			x[i] = cpx{re: float32(r.NormFloat64()), im: float32(r.NormFloat64())}
+		}
+		for _, sign := range []float32{-1, 1} {
+			schnell := make([]cpx, n)
+			cfft(x, schnell, sign)
+			soll := naiveDft(x, sign)
+			var groesste float64
+			for _, v := range soll {
+				if a := math.Hypot(float64(v.re), float64(v.im)); a > groesste {
+					groesste = a
+				}
+			}
+			grenze := groesste * 1e-4
+			for i := range soll {
+				d := math.Hypot(float64(schnell[i].re-soll[i].re), float64(schnell[i].im-soll[i].im))
+				if d > grenze {
+					t.Fatalf("n=%d sign=%v Stelle %d: Abweichung %v, erlaubt %v",
+						n, sign, i, d, grenze)
+				}
+			}
+		}
+	}
+}
diff -ruN meowcaller-rein/mlow/fft_real_test.go meowcaller-fix/mlow/fft_real_test.go
--- a/mlow/fft_real_test.go	1970-01-01 01:00:00.000000000 +0100
+++ b/mlow/fft_real_test.go	2026-09-24 22:37:23.593344929 +0200
@@ -0,0 +1,67 @@
+package mlow
+
+import (
+	"math"
+	"math/rand"
+	"testing"
+)
+
+// Die halblange reelle FFT muss dasselbe liefern wie die komplexe FFT
+// voller Laenge -- das ist der einzige Beleg dafuer, dass die Entflechtung
+// stimmt. Geprueft werden die Laengen, die der Kodierer wirklich benutzt.
+func TestRfftGleichWieVolleFft(t *testing.T) {
+	r := rand.New(rand.NewSource(7))
+	for _, n := range []int{4, 8, 16, 64, 256, 288, 512, 576} {
+		zeit := make([]float32, n)
+		for i := range zeit {
+			zeit[i] = float32(r.NormFloat64())
+		}
+		schnell := make([]float32, n)
+		voll := make([]float32, n)
+		rfftForwardOrdered(zeit, schnell)
+		rfftForwardOrderedVoll(zeit, voll)
+
+		var groesste float64
+		for _, v := range voll {
+			if a := math.Abs(float64(v)); a > groesste {
+				groesste = a
+			}
+		}
+		grenze := groesste * 1e-4
+		for i := range voll {
+			if d := math.Abs(float64(schnell[i] - voll[i])); d > grenze {
+				t.Fatalf("n=%d, Stelle %d: %v statt %v (Abweichung %v, erlaubt %v)",
+					n, i, schnell[i], voll[i], d, grenze)
+			}
+		}
+	}
+}
+
+// Ein reiner Ton muss genau in seinem Fach landen und sonst nirgends.
+func TestRfftTonImRichtigenFach(t *testing.T) {
+	const n, fach = 512, 7
+	zeit := make([]float32, n)
+	for i := range zeit {
+		zeit[i] = float32(math.Cos(2 * math.Pi * fach * float64(i) / n))
+	}
+	f := make([]float32, n)
+	rfftForwardOrdered(zeit, f)
+	betrag := func(k int) float64 {
+		if k == 0 {
+			return math.Abs(float64(f[0]))
+		}
+		re, im := float64(f[2*k]), float64(f[2*k+1])
+		return math.Hypot(re, im)
+	}
+	if b := betrag(fach); b < 0.4*n {
+		t.Fatalf("Fach %d hat nur %v", fach, b)
+	}
+	for k := 1; k < n/2; k++ {
+		if k == fach {
+			continue
+		}
+		if b := betrag(k); b > 0.01*n {
+			t.Fatalf("Fach %d sollte leer sein, hat aber %v", k, b)
+		}
+	}
+}
