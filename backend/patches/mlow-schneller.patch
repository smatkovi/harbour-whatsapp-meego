diff -ruN meowcaller-rein/mlow/cng_test.go meowcaller-fix/mlow/cng_test.go
--- a/mlow/cng_test.go	1970-01-01 01:00:00.000000000 +0100
+++ b/mlow/cng_test.go	2026-09-24 23:08:59.359620388 +0200
@@ -0,0 +1,75 @@
+package mlow
+
+import (
+	"math"
+	"testing"
+)
+
+func effektivwert(x []float32) float64 {
+	var s float64
+	for _, v := range x {
+		s += float64(v) * float64(v)
+	}
+	return math.Sqrt(s / float64(len(x)))
+}
+
+// Ohne Schalter bleibt ein inaktiver Rahmen digitale Stille; mit Schalter
+// kommt leises Rauschen heraus, und zwar hoechstens so laut wie die
+// leisesten Stellen der zuletzt gehoerten Sprache.
+func TestKomfortrauschen(t *testing.T) {
+	inaktiv := []byte{0x10} // 16 kHz, 60 ms, nicht aktiv
+
+	cngEinmal.Do(func() {})
+	cngWert = false
+	aus := NewMlowDecoder()
+	if e := effektivwert(aus.Decode(inaktiv)); e != 0 {
+		t.Fatalf("ohne Schalter kam Rauschen mit Effektivwert %v", e)
+	}
+
+	cngWert = true
+	defer func() { cngWert = false }()
+
+	// Ohne gehoerte Sprache weiss der Dekodierer den Pegel nicht -- dann
+	// bleibt es still, statt zu raten.
+	frisch := NewMlowDecoder()
+	if e := effektivwert(frisch.Decode(inaktiv)); e != 0 {
+		t.Fatalf("ohne Pegelkenntnis kam Rauschen mit Effektivwert %v", e)
+	}
+
+	// Pegel aus einem "gehoerten" Rahmen lernen.
+	d := NewMlowDecoder()
+	leise := make([]float32, 960)
+	for i := range leise {
+		leise[i] = 0.002 * float32(math.Sin(float64(i)*0.3))
+	}
+	d.pegelMerken(leise)
+
+	rahmen := d.Decode(inaktiv)
+	e := effektivwert(rahmen)
+	if e == 0 {
+		t.Fatal("mit Schalter und Pegel kam trotzdem Stille")
+	}
+	if e > cngHoechstpegel*3 {
+		t.Fatalf("Rauschen zu laut: Effektivwert %v, Deckel %v", e, cngHoechstpegel)
+	}
+	for i, v := range rahmen {
+		if math.IsNaN(float64(v)) || math.Abs(float64(v)) > 0.05 {
+			t.Fatalf("Stelle %d: %v", i, v)
+		}
+	}
+	// Eingeblendet: der Anfang ist leiser als das Ende.
+	if effektivwert(rahmen[:100]) >= effektivwert(rahmen[860:]) {
+		t.Fatal("das Rauschen wird nicht eingeblendet")
+	}
+
+	// Ein lauter Rahmen darf den Grundpegel nicht sofort mitreissen.
+	vorher := d.grundpegel
+	laut := make([]float32, 960)
+	for i := range laut {
+		laut[i] = 0.5
+	}
+	d.pegelMerken(laut)
+	if d.grundpegel > vorher*1.05 {
+		t.Fatalf("Grundpegel sprang von %v auf %v", vorher, d.grundpegel)
+	}
+}
