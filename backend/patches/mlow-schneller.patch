+
+// komfortRauschen fuellt einen inaktiven Rahmen mit leisem Rauschen statt
+// mit digitaler Stille.
+//
+// Die Gegenseite schickt in Sprechpausen inaktive Rahmen -- WhatsApp hat
+// DTX in den voip_settings stehen. Bisher gab der Dekodierer dafuer
+// lauter Nullen aus, und das klingt nicht wie eine Pause, sondern wie
+// eine abgerissene Leitung: zwischen zwei Woertern verschwindet auch das
+// Grundgeraeusch des anderen Raumes, das man die ganze Zeit gehoert hat.
+// Genau dagegen gibt es Komfortrauschen.
+//
+// Die Hoehe des Rauschens schaetzen wir selbst, aus den leisesten
+// Stellen der zuletzt dekodierten Sprache (Minimumstatistik: der Pegel
+// faellt sofort auf ein neues Minimum und steigt nur langsam wieder).
+// Die Rahmen der Gegenseite tragen keine Angaben dazu -- unser
+// Dekodierer liest von einem inaktiven Rahmen ueberhaupt nur das erste
+// Byte.
+//
+// Eingeblendet wird ueber den ersten Rahmen, sonst klickt es beim
+// Uebergang. Nach oben ist der Pegel hart gedeckelt: lieber zu leise als
+// ein Zischen ueber dem Gespraech.
+func (d *MlowDecoder) komfortRauschen(outLen int) []float32 {
+	out := make([]float32, outLen)
+	if !cngAn() || !d.pegelKennt {
+		d.rauschAuf = 0
+		return out
+	}
+	pegel := d.grundpegel
+	if pegel > cngHoechstpegel {
+		pegel = cngHoechstpegel
+	}
+	if pegel <= 0 {
+		return out
+	}
+	if d.rauschSaat == 0 {
+		d.rauschSaat = 12345
+	}
+	for i := range out {
+		d.rauschSaat = smplRand(d.rauschSaat)
+		// Gleichverteilt in [-1,1), dann ein einpoliger Tiefpass: weisses
+		// Rauschen klingt scharf, das Grundgeraeusch eines Raumes nicht.
+		weiss := float32(d.rauschSaat>>8) / 8388608.0
+		d.rauschTief = 0.8*d.rauschTief + 0.2*weiss
+		if d.rauschAuf < 1 {
+			d.rauschAuf += 1.0 / float32(outLen)
+		}
+		out[i] = d.rauschTief * pegel * 3.0 * d.rauschAuf
+	}
+	return out
+}
+
+// pegelMerken zieht den Grundgeraeuschpegel aus einem dekodierten Rahmen
+// nach: sofort herunter auf ein neues Minimum, langsam wieder hinauf.
+func (d *MlowDecoder) pegelMerken(pcm []float32) {
+	if len(pcm) == 0 {
+		return
+	}
+	var summe float64
+	for _, v := range pcm {
+		summe += float64(v) * float64(v)
+	}
+	effektiv := float32(math.Sqrt(summe / float64(len(pcm))))
+	d.rauschAuf = 0
+	if !d.pegelKennt {
+		d.grundpegel = effektiv
+		d.pegelKennt = true
+		return
+	}
+	if effektiv < d.grundpegel {
+		d.grundpegel = effektiv
+		return
+	}
+	// Langsam nach oben, damit ein einzelner lauter Rahmen den Pegel
+	// nicht mitreisst: gut zwei Prozent je Rahmen sind bei 60 ms rund
+	// eine Verdopplung in zwei Sekunden.
+	d.grundpegel *= 1.025
+	if d.grundpegel > effektiv {
+		d.grundpegel = effektiv
+	}
+}
+
+// cngHoechstpegel deckelt das Komfortrauschen (etwa -46 dBFS).
+const cngHoechstpegel = 0.005
+
+var (
+	cngEinmal sync.Once
+	cngWert   bool
+)
+
+// cngAn liest einmalig, ob Komfortrauschen gewuenscht ist (MLOW_CNG=1).
+func cngAn() bool {
+	cngEinmal.Do(func() { cngWert = os.Getenv("MLOW_CNG") == "1" })
+	return cngWert
 }
 
